<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Axiom.Shared.Controls"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Axiom.Shared.Icons">

  <!--
    ========================================
    OPTION PANELS
    ========================================
    Every option page is a MasonryPanel of OptionPanels: cards with a small uppercase header and one
    OptionRow per option. The label column has the same width in every row, so the fields line up, and the
    fields stretch to the end of the row.
  -->

  <Style TargetType="controls:OptionPanel">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:OptionPanel">
          <Border Padding="14,10,14,10" Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel
                Margin="0,0,0,8"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <Path
                  Margin="0,0,8,0"
                  Data="{TemplateBinding Icon}"
                  Fill="{DynamicResource PrimaryBrush}"
                  Style="{StaticResource Icon.Small}" />
                <ContentPresenter
                  VerticalAlignment="Center"
                  ContentSource="Header"
                  TextElement.FontSize="{StaticResource FontSize.XS}"
                  TextElement.FontWeight="SemiBold"
                  TextElement.Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <ContentPresenter />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:OptionRow">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:OptionRow">
          <Grid MinHeight="32" Margin="0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource TemplatedParent}}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="Label"
              Margin="0,0,10,0"
              VerticalAlignment="Center"
              FontSize="{StaticResource FontSize.Sm}"
              Foreground="{DynamicResource SecondaryTextBrush}"
              Text="{TemplateBinding Label}"
              TextTrimming="CharacterEllipsis" />
            <ContentPresenter
              Grid.Column="1"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Label" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The masonry of panels on every option page  -->
  <Style x:Key="OptionPages" TargetType="controls:MasonryPanel">
    <Setter Property="Margin" Value="0,12,0,4" />
    <Setter Property="MinColumnWidth" Value="300" />
    <Setter Property="MaxColumns" Value="3" />
    <Setter Property="Spacing" Value="12" />
  </Style>

  <!--  A thin line between groups of rows inside a panel  -->
  <Style x:Key="PanelDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!--  A short note under a group of rows  -->
  <Style
    x:Key="PanelNote"
    BasedOn="{StaticResource TextBlockCaption}"
    TargetType="TextBlock">
    <Setter Property="Margin" Value="0,4,0,2" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
  </Style>

  <!--
    ========================================
    FIELDS
    ========================================
  -->

  <!--  A switch at the start of the field column  -->
  <Style
    x:Key="OptionSwitch"
    BasedOn="{StaticResource ToggleButtonSwitch.Small}"
    TargetType="ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!--  A small on/off chip next to a field (VBR, Auto...)  -->
  <Style
    x:Key="OptionChip"
    BasedOn="{StaticResource ToggleButtonDefault}"
    TargetType="ToggleButton">
    <Setter Property="Height" Value="{StaticResource Control.Height}" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--  Shows or hides the rows under it (advanced bit rate, optimize details): a caret that turns over  -->
  <Style x:Key="Disclosure" TargetType="ToggleButton">
    <Setter Property="Width" Value="{StaticResource Control.Height}" />
    <Setter Property="Height" Value="{StaticResource Control.Height}" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            CornerRadius="{StaticResource Radius.Sm}">
            <Path
              x:Name="Caret"
              HorizontalAlignment="Center"
              Data="{icons:Phosphor CaretDownBold}"
              RenderTransformOrigin="0.5,0.5"
              Style="{StaticResource Icon.Small}">
              <Path.RenderTransform>
                <RotateTransform />
              </Path.RenderTransform>
            </Path>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="Caret"
                      Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                      To="180"
                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="Caret"
                      Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                      To="0"
                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The rows a Disclosure shows: indented under a hairline on the left  -->
  <Style x:Key="DisclosedRows" TargetType="Border">
    <Setter Property="Margin" Value="4,2,0,4" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>

  <!--  A list inside a panel (muxed streams, output naming): framed like a field  -->
  <Style
    x:Key="OptionList"
    BasedOn="{StaticResource {x:Type ListView}}"
    TargetType="ListView">
    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!--  The number box next to a slider  -->
  <Style
    x:Key="SliderValue"
    BasedOn="{StaticResource TextBox.Small}"
    TargetType="TextBox">
    <Setter Property="Width" Value="52" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
  </Style>

  <Style
    x:Key="OptionSlider"
    BasedOn="{StaticResource {x:Type Slider}}"
    TargetType="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
  </Style>

  <!--
    A time code, hh:mm:ss.ms: one framed field holding a borderless box per part, so it reads as one
    field and every part keeps its own key handling.
  -->
  <Style x:Key="TimeField" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Control.Height}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="TimePart" TargetType="TextBox">
    <Setter Property="Width" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="MaxLength" Value="2" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
  </Style>

  <Style x:Key="TimeSeparator" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
  </Style>

  <!--  The dash between a start and an end  -->
  <Style x:Key="RangeDash" TargetType="TextBlock">
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
    <Setter Property="Text" Value="–" />
  </Style>

</ResourceDictionary>
