<Window
  x:Class="Axiom.CropWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:System="clr-namespace:System;assembly=mscorlib"
  xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
  xmlns:Themes1="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:iconPack="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:local="clr-namespace:ViewModel"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:my="clr-namespace:Axiom"
  Title="Crop"
  Width="480"
  Height="270"
  Icon="axiom.ico"
  RenderOptions.BitmapScalingMode="Fant"
  ResizeMode="CanMinimize"
  Style="{DynamicResource WindowCrop}"
  UseLayoutRounding="True"
  mc:Ignorable="d">

  <Window.DataContext>
    <local:VM />
  </Window.DataContext>

  <Grid>

    <!--  Crop X  -->
    <Label
      Width="20"
      Margin="15,107,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Content="X" />
    <TextBox
      x:Name="tbxCropX"
      Width="60"
      Height="22"
      Margin="32,109,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      KeyDown="tbxVideo_Crop_X_KeyDown"
      MaxLines="1"
      Text="{Binding VideoView.Video_Crop_X_Text, Mode=TwoWay}"
      TextWrapping="NoWrap"
      ToolTip="Position of Crop from Left"
      ToolTipService.ShowOnDisabled="True" />

    <!--  Crop Y  -->
    <Label
      Width="21"
      Margin="186,15,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Content="Y"
      Style="{DynamicResource LabelStyle}" />
    <TextBox
      x:Name="tbxCropY"
      Width="60"
      Height="22"
      Margin="202,17,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      KeyDown="tbxVideo_Crop_Y_KeyDown"
      MaxLines="1"
      Text="{Binding VideoView.Video_Crop_Y_Text, Mode=TwoWay}"
      TextWrapping="NoWrap"
      ToolTip="Position of Crop from Top"
      ToolTipService.ShowOnDisabled="True" />

    <!--  Crop Width  -->
    <Label
      Width="44"
      Margin="178,84,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Content="Width"
      Style="{DynamicResource LabelStyle}" />
    <TextBox
      x:Name="tbxCropWidth"
      Width="60"
      Height="22"
      Margin="170,109,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      KeyDown="tbxVideo_Crop_Width_KeyDown"
      MaxLines="1"
      Text="{Binding VideoView.Video_Crop_Width_Text, Mode=TwoWay}"
      TextWrapping="NoWrap"
      ToolTip="Width of Cropped Area"
      ToolTipService.ShowOnDisabled="True" />

    <!--  Crop Height  -->
    <Label
      Width="48"
      Margin="241,84,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Content="Height"
      Style="{DynamicResource LabelStyle}" />
    <TextBox
      x:Name="tbxCropHeight"
      Width="60"
      Height="22"
      Margin="235,109,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      KeyDown="tbxVideo_Crop_Height_KeyDown"
      MaxLines="1"
      Text="{Binding VideoView.Video_Crop_Height_Text, Mode=TwoWay}"
      TextWrapping="NoWrap"
      ToolTip="Height of Cropped Area"
      ToolTipService.ShowOnDisabled="True" />

    <!--  Diagram Border  -->
    <Rectangle
      Width="270"
      Height="152"
      Margin="97,44,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Stroke="White"
      StrokeThickness="1" />

    <!--  Set button  -->
    <Button
      x:Name="buttonSet"
      Width="60"
      Margin="387,194,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Click="btnSet_Click"
      Cursor="Hand">
      <TextBlock Text="Set" />
    </Button>

    <!--  Clear Button  -->
    <Button
      x:Name="btnClear"
      Width="60"
      Margin="17,194,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Click="btnClear_Click"
      Cursor="Hand">
      <TextBlock Text="Clear" />
    </Button>

  </Grid>
</Window>
