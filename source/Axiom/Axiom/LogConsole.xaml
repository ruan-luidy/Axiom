<Window
  x:Class="Axiom.LogConsole"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:System="clr-namespace:System;assembly=mscorlib"
  xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
  xmlns:Themes1="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Log Console"
  Width="400"
  Height="500"
  Icon="Resources/Images/Icons/LogConsole.ico"
  mc:Ignorable="d">
  <Grid>

    <RichTextBox
      Name="rtbLog"
      Margin="0"
      Padding="10"
      Background="{x:Null}"
      FontFamily="Consolas"
      Foreground="{DynamicResource PrimaryTextBrush}"
      IsReadOnly="True"
      IsUndoEnabled="False"
      RenderOptions.ClearTypeHint="Enabled"
      VerticalScrollBarVisibility="Visible" />
    <!--<FlowDocument>
                <Paragraph>
                    <Run Text="{Binding LogConsole_Text, Mode=OneWay}" />
                </Paragraph>
            </FlowDocument>
        </RichTextBox>-->

    <Button
      x:Name="btnExpand"
      Width="20"
      Height="20"
      Margin="0,10,28,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Background="{x:Null}"
      BorderBrush="#7FFFFFFF"
      Click="btnExpand_Click"
      Cursor="Hand"
      Foreground="White"
      ToolTip="Expand Window">
      <TextBlock
        x:Name="textBlockExpand"
        Margin="0,-2,0,0"
        Foreground="#99FFFFFF"
        Text="+" />
    </Button>

  </Grid>
</Window>
