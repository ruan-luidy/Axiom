<!--
  Video Encoding Control
  Extracted from MainWindow.xaml (Lines 992-1948)
  Contains: Encoding, HW Accel, Quality, and Optimize groups
-->
<UserControl
  x:Class="Axiom.Views.VideoEncodingControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="clr-namespace:HandyControl.Collections;assembly=HandyControl"
  xmlns:iconPack="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <StackPanel Margin="10,10,10,0" Background="Transparent">

    <!--  Encoding Group  -->
    <StackPanel Margin="0,0,0,15">
      <!--  Encoding Header  -->
      <Label
        Margin="0,0,0,5"
        HorizontalAlignment="Left"
        Background="Transparent"
        BorderThickness="0"
        Content="Encoding"
        FontFamily="Segoe UI Semibold" />

      <!--  Video Codec Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Video Codec"
          FontFamily="Segoe UI Semilight" />

        <ComboBox
          x:Name="cboVideo_Codec"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_Codec_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsSynchronizedWithCurrentItem="True"
          ItemsSource="{Binding Video_Codec_Items}"
          SelectedIndex="{Binding Video_Codec_SelectedIndex}"
          SelectedItem="{Binding Video_Codec_SelectedItem}"
          SelectionChanged="cboVideo_Codec_SelectionChanged" />
      </Grid>

      <!--  Encode Speed Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Encode Speed"
          FontFamily="Segoe UI Semilight"
          ToolTip="Encoding Speed. Slower = Better Quality &amp; Compression."
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <ComboBox
          x:Name="cboEncodeSpeed"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_EncodeSpeed_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          ItemsSource="{Binding Video_EncodeSpeed_Items}"
          SelectedIndex="{Binding Video_EncodeSpeed_SelectedIndex}"
          SelectedValue="{Binding Video_EncodeSpeed_SelectedItem, Mode=TwoWay}"
          SelectedValuePath="Name"
          SelectionChanged="cboEncodeSpeed_SelectionChanged"
          ToolTip="Encoding Speed. Slower = Better Quality &amp; Compression."
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock DataContext="{Binding}">
                  <TextBlock.Text>
                    <Binding Path="Name" />
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </StackPanel>

    <!--  HW Accel Group  -->
    <StackPanel Margin="0,0,0,15">
      <!--  HW Accel Header  -->
      <Label
        Margin="0,0,0,5"
        HorizontalAlignment="Left"
        Background="Transparent"
        BorderThickness="0"
        Content="HW Accel"
        FontFamily="Segoe UI Semibold" />

      <!--  HW Acceleration Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="HW Accel"
          FontFamily="Segoe UI Semilight"
          ToolTip="Hardware Acceleration"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <ComboBox
          x:Name="cboHWAccel"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_HWAccel_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsSynchronizedWithCurrentItem="True"
          ItemsSource="{Binding Video_HWAccel_Items}"
          SelectedIndex="{Binding Video_HWAccel_SelectedIndex}"
          SelectedItem="{Binding Video_HWAccel_SelectedItem}"
          SelectionChanged="cboHWAccel_SelectionChanged"
          ToolTip="Hardware Acceleration" />
      </Grid>

      <!--  HW Decode Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Decode"
          FontFamily="Segoe UI Semilight"
          ToolTip="Hardware Acceleration Decode"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <ComboBox
          x:Name="cboHWAccelDecode"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_HWAccel_Decode_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsSynchronizedWithCurrentItem="True"
          ItemsSource="{Binding Video_HWAccel_Decode_Items}"
          SelectedIndex="{Binding Video_HWAccel_Decode_SelectedIndex}"
          SelectedItem="{Binding Video_HWAccel_Decode_SelectedItem, Mode=TwoWay}"
          ToolTip="Hardware Acceleration Decode"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />
      </Grid>

      <!--  HW Transcode Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Transcode"
          FontFamily="Segoe UI Semilight"
          ToolTip="Hardware Acceleration Transcode"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <ComboBox
          x:Name="cboHWAccelTranscode"
          Grid.Column="1"
          Width="105"
          Height="22"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_HWAccel_Transcode_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsSynchronizedWithCurrentItem="True"
          ItemsSource="{Binding Video_HWAccel_Transcode_Items}"
          SelectedIndex="{Binding Video_HWAccel_Transcode_SelectedIndex}"
          SelectedItem="{Binding Video_HWAccel_Transcode_SelectedItem, Mode=TwoWay}"
          SelectionChanged="cboHWAccelTranscode_SelectionChanged"
          ToolTip="Hardware Acceleration Transcode"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />
      </Grid>
    </StackPanel>

    <!--  Quality Group  -->
    <StackPanel Margin="0,0,0,15">
      <!--  Quality Header  -->
      <Label
        Margin="0,0,0,5"
        HorizontalAlignment="Left"
        Background="Transparent"
        BorderThickness="0"
        Content="Quality"
        FontFamily="Segoe UI Semibold" />

      <!--  Quality Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Quality"
          FontFamily="Segoe UI Semilight" />

        <ComboBox
          x:Name="cboVideo_Quality"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_Quality_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsSynchronizedWithCurrentItem="True"
          ItemsSource="{Binding Video_Quality_Items}"
          SelectedValue="{Binding Video_Quality_SelectedItem, Mode=TwoWay}"
          SelectedValuePath="Name"
          SelectionChanged="cboVideo_Quality_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock DataContext="{Binding}">
                  <TextBlock.Text>
                    <Binding Path="Name" />
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <!--  Pass Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Pass"
          FontFamily="Segoe UI Semilight"
          ToolTip="Encoding Pass Method" />

        <ComboBox
          x:Name="cboVideo_Pass"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          DropDownClosed="cboVideo_Pass_DropDownClosed"
          IsEnabled="{Binding Video_Pass_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          ItemsSource="{Binding Video_Pass_Items}"
          SelectedIndex="{Binding Video_Pass_SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          SelectedValue="{Binding Video_Pass_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          SelectionChanged="cboVideo_Pass_SelectionChanged"
          ToolTip="Encoding Pass Method"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />
      </Grid>

      <!--  CRF Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="CRF"
          FontFamily="Segoe UI Semilight"
          ToolTip="Constant Rate Factor. Lower value is higher quality."
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <Grid Grid.Column="1">
          <Slider
            x:Name="slVideo_CRF"
            Height="18"
            Margin="0,4,42,0"
            VerticalAlignment="Top"
            Background="{DynamicResource BorderBrush}"
            IsDirectionReversed="True"
            IsEnabled="{Binding Video_CRF_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsMoveToPointEnabled="True"
            IsSnapToTickEnabled="True"
            Maximum="51"
            Minimum="0"
            MouseDoubleClick="slVideo_CRF_MouseDoubleClick"
            ToolTip="Constant Rate Factor. Lower value is higher quality."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True"
            ValueChanged="slVideo_CRF_ValueChanged"
            Value="{Binding Video_CRF_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox
            x:Name="tbxVideo_CRF"
            Width="30"
            Height="22"
            Margin="75,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Video_CRF_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="tbxVideo_CRF_KeyDown"
            MaxLength="2"
            MaxLines="1"
            Text="{Binding Video_CRF_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="tbxVideo_CRF_TextChanged"
            TextWrapping="NoWrap"
            ToolTip="Constant Rate Factor. Lower value is higher quality."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />
        </Grid>
      </Grid>

      <!--  Video Bit Rate Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Bit Rate"
          FontFamily="Segoe UI Semilight"
          ToolTip="Video Bit Rate (e.g. 1000K or 1M)"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <Grid Grid.Column="1">
          <TextBox
            x:Name="tbxVideo_BitRate"
            Width="70"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Center"
            IsEnabled="{Binding Video_BitRate_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            MaxLength="10"
            MaxLines="1"
            Text="{Binding Video_BitRate_Text, Mode=TwoWay}"
            TextWrapping="NoWrap"
            ToolTip="Video Bit Rate (e.g. 1000K or 1M)"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />
          <ToggleButton
            x:Name="tglVideo_VBR"
            Margin="75,1,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Checked="tglVideo_VBR_Checked"
            Content="VBR"
            Cursor="Hand"
            IsChecked="{Binding Video_VBR_IsChecked}"
            IsEnabled="{Binding Video_VBR_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Toggle Variable Bit Rate."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True"
            Unchecked="tglVideo_VBR_Unchecked" />
        </Grid>
      </Grid>

      <!--  Bit Rate Advanced Expander Button  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button
          x:Name="btnVideoBitRateAdvanced_Expand"
          Grid.Column="0"
          Width="28"
          Height="28"
          Margin="0,3,15,0"
          Padding="0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Click="btnVideoBitRateAdvanced_Expand_Click"
          Cursor="Hand"
          ToolTip="Show Advanced Bit Rate Controls"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True">
          <iconPack:PackIconPhosphorIcons
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource PrimaryTextBrush}"
            Kind="Plus" />
        </Button>
      </Grid>

      <!--  Bit Rate Advanced Expander  -->
      <Expander
        x:Name="expVideo_BitRateAdvanced_Expander"
        Margin="0,0,0,0"
        Panel.ZIndex="0"
        Background="Transparent"
        BorderBrush="Transparent"
        Collapsed="expVideo_BitRateAdvanced_Expander_Collapsed"
        Expanded="expVideo_BitRateAdvanced_Expander_Expanded"
        Foreground="Transparent"
        IsExpanded="{Binding Video_BitRateAdvanced_IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

        <Expander.Header>
          <StackPanel>
            <TextBlock x:Name="expVideo_BitRateAdvanced_Expander_Header" IsEnabled="False" />
          </StackPanel>
        </Expander.Header>

        <StackPanel Margin="0,-17,0,0">
          <!--  Video Min Rate Row  -->
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
              Grid.Column="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Content="Min Rate"
              FontFamily="Segoe UI Semilight"
              ToolTip="Video Min Bit Rate (e.g. 1000K or 1M)"
              ToolTipService.InitialShowDelay="500"
              ToolTipService.ShowOnDisabled="True" />

            <TextBox
              x:Name="tbxVideo_MinRate"
              Grid.Column="1"
              Width="105"
              Height="22"
              Padding="1,1,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsEnabled="{Binding Video_MinRate_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              MaxLength="10"
              MaxLines="1"
              Text="{Binding Video_MinRate_Text, Mode=TwoWay}"
              TextWrapping="NoWrap"
              ToolTip="Video Min Bit Rate (e.g. 1000K or 1M)"
              ToolTipService.InitialShowDelay="500"
              ToolTipService.ShowOnDisabled="True" />
          </Grid>

          <!--  Video Max Rate Row  -->
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
              Grid.Column="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Content="Max Rate"
              FontFamily="Segoe UI Semilight"
              ToolTip="Video Max Bit Rate (e.g. 1000K or 1M)"
              ToolTipService.InitialShowDelay="500"
              ToolTipService.ShowOnDisabled="True" />

            <TextBox
              x:Name="tbxVideo_MaxRate"
              Grid.Column="1"
              Width="105"
              Height="22"
              Padding="1,1,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsEnabled="{Binding Video_MaxRate_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              MaxLength="10"
              MaxLines="1"
              Text="{Binding Video_MaxRate_Text, Mode=TwoWay}"
              TextWrapping="NoWrap"
              ToolTip="Video Max Bit Rate (e.g. 1000K or 1M)"
              ToolTipService.InitialShowDelay="500"
              ToolTipService.ShowOnDisabled="True" />
          </Grid>

          <!--  Video Buf Size Row  -->
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
              Grid.Column="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Content="Buf Size"
              FontFamily="Segoe UI Semilight"
              ToolTip="Rate Control Buffer (e.g. 1000K or 1M)"
              ToolTipService.InitialShowDelay="500"
              ToolTipService.ShowOnDisabled="True" />

            <TextBox
              x:Name="tbxVideo_BufSize"
              Grid.Column="1"
              Width="105"
              Height="22"
              Padding="1,1,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsEnabled="{Binding Video_BufSize_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              MaxLength="10"
              MaxLines="1"
              Text="{Binding Video_BufSize_Text, Mode=TwoWay}"
              TextWrapping="NoWrap"
              ToolTip="Rate Control Buffer (e.g. 1000K or 1M)"
              ToolTipService.InitialShowDelay="500"
              ToolTipService.ShowOnDisabled="True" />
          </Grid>
        </StackPanel>
      </Expander>

      <!--  Pix Format Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Pixel Format"
          FontFamily="Segoe UI Semilight" />

        <ComboBox
          x:Name="cboVideo_PixelFormat"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_PixelFormat_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsSynchronizedWithCurrentItem="True"
          IsTextSearchEnabled="False"
          ItemsSource="{Binding Video_PixelFormat_Items}"
          SelectedIndex="{Binding Video_PixelFormat_SelectedIndex}"
          SelectedItem="{Binding Video_PixelFormat_SelectedItem}"
          SelectionChanged="cboVideo_PixelFormat_SelectionChanged" />
      </Grid>

      <!--  Framerate Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Frame Rate"
          FontFamily="Segoe UI Semilight"
          ToolTip="Frames Per Second"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <ComboBox
          x:Name="cboVideo_FrameRate"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEditable="{Binding Video_FPS_IsEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsEnabled="{Binding Video_FPS_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsTextSearchEnabled="False"
          ItemsSource="{Binding Video_FPS_Items}"
          SelectedIndex="{Binding Video_FPS_SelectedIndex}"
          SelectedItem="{Binding Video_FPS_SelectedItem}"
          SelectionChanged="cboVideo_FPS_SelectionChanged"
          Text="{Binding Video_FPS_Text}"
          TextBoxBase.KeyDown="cboVideo_FrameRate_KeyDown"
          ToolTip="Frames Per Second"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />
      </Grid>

      <!--  Speed Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Speed"
          FontFamily="Segoe UI Semilight"
          ToolTip="Speed Up / Slow Down Video"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />

        <ComboBox
          x:Name="cboVideo_Speed"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEditable="{Binding Video_Speed_IsEditable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsEnabled="{Binding Video_Speed_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsTextSearchEnabled="False"
          ItemsSource="{Binding Video_Speed_Items}"
          SelectedIndex="{Binding Video_Speed_SelectedIndex}"
          SelectedItem="{Binding Video_Speed_SelectedItem}"
          SelectionChanged="cboVideo_Speed_SelectionChanged"
          Text="{Binding Video_Speed_Text}"
          TextBoxBase.KeyDown="cboVideo_Speed_KeyDown"
          ToolTip="Speed Up / Slow Down Video"
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True" />
      </Grid>

      <!--  Vsync Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Vsync"
          FontFamily="Segoe UI Semilight">
          <Label.ToolTip>
            <TextBlock>
              auto: Chooses between 1 and 2 depending on muxer capabilities. This is the default method.<LineBreak />
              passthrough: Each frame is passed with its timestamp from the demuxer to the muxer.<LineBreak />
              cfr: Frames will be duplicated and dropped to achieve exactly the requested constant frame rate.<LineBreak />
              vfr: Frames are passed through with their timestamp or dropped so as to prevent 2 frames from having the same timestamp.<LineBreak />
              drop: As passthrough but destroys all timestamps, making the muxer generate fresh timestamps based on frame-rate.</TextBlock>
          </Label.ToolTip>
        </Label>

        <ComboBox
          x:Name="cboVideo_Vsync"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,2,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsEnabled="{Binding Video_Vsync_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          ItemsSource="{Binding Video_Vsync_Items}"
          SelectedItem="{Binding Video_Vsync_SelectedItem, Mode=TwoWay}"
          SelectionChanged="cboVideo_Vsync_SelectionChanged" />
      </Grid>
    </StackPanel>

    <!--  Optimize Group  -->
    <StackPanel Margin="0,0,0,0">
      <!--  Optimize Header  -->
      <Label
        Margin="0,0,0,5"
        HorizontalAlignment="Left"
        Background="Transparent"
        BorderThickness="0"
        Content="Optimize"
        FontFamily="Segoe UI Semibold" />

      <!--  Optimize Row  -->
      <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label
          Grid.Column="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content="Optimize"
          FontFamily="Segoe UI Semilight" />

        <ComboBox
          x:Name="cboVideo_Optimize"
          Grid.Column="1"
          Width="105"
          Height="22"
          Margin="0,1,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Panel.ZIndex="1"
          IsEnabled="{Binding Video_Optimize_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsSynchronizedWithCurrentItem="True"
          ItemsSource="{Binding Video_Optimize_Items}"
          SelectedIndex="{Binding Video_Optimize_SelectedIndex}"
          SelectedValue="{Binding Video_Optimize_SelectedItem, Mode=TwoWay}"
          SelectedValuePath="Name"
          SelectionChanged="cboVideo_Optimize_SelectionChanged"
          ToolTip="Optimize file for device type."
          ToolTipService.InitialShowDelay="500"
          ToolTipService.ShowOnDisabled="True">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock DataContext="{Binding}">
                  <TextBlock.Text>
                    <Binding Path="Name" />
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <!--  Expander  -->
      <Expander
        x:Name="expVideo_Optimize_Expander"
        Margin="0,0,10,0"
        Panel.ZIndex="0"
        IsEnabled="{Binding Video_Optimize_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        IsExpanded="{Binding Video_Optimize_IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

        <Expander.Header>
          <StackPanel>
            <TextBlock x:Name="expVideo_Optimize_Expander_Header" IsEnabled="False" />
          </StackPanel>
        </Expander.Header>

        <StackPanel Margin="0,-17,0,0">
          <!--  Tune Row  -->
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
              Grid.Column="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Content="Tune" />

            <ComboBox
              x:Name="cboVideo_Optimize_Tune"
              Grid.Column="1"
              Width="105"
              Margin="0,2,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsEnabled="{Binding Video_Optimize_Tune_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsSynchronizedWithCurrentItem="True"
              ItemsSource="{Binding Video_Optimize_Tune_Items}"
              SelectedIndex="{Binding Video_Optimize_Tune_SelectedIndex}"
              SelectedItem="{Binding Video_Optimize_Tune_SelectedItem, Mode=TwoWay}" />
          </Grid>

          <!--  Profile Row  -->
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
              Grid.Column="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Content="Profile" />

            <ComboBox
              x:Name="cboVideo_Optimize_Profile"
              Grid.Column="1"
              Width="105"
              Margin="0,2,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsEnabled="{Binding Video_Optimize_Profile_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsSynchronizedWithCurrentItem="True"
              ItemsSource="{Binding Video_Optimize_Profile_Items}"
              SelectedIndex="{Binding Video_Optimize_Profile_SelectedIndex}"
              SelectedItem="{Binding Video_Optimize_Profile_SelectedItem, Mode=TwoWay}" />
          </Grid>

          <!--  Level Row  -->
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
              Grid.Column="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Content="Level" />

            <ComboBox
              x:Name="cboVideo_Optimize_Level"
              Grid.Column="1"
              Width="105"
              Margin="0,2,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsEnabled="{Binding Video_Optimize_Level_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsSynchronizedWithCurrentItem="True"
              ItemsSource="{Binding Video_Optimize_Level_Items}"
              SelectedIndex="{Binding Video_Optimize_Level_SelectedIndex}"
              SelectedItem="{Binding Video_Optimize_Level_SelectedItem, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Expander>
    </StackPanel>

  </StackPanel>
</UserControl>
