<!--
  Process Control Panel
  Extracted from MainWindow.xaml (Lines 7845-8011)
  Contains: Preset Management and Convert/Preview buttons
-->
<UserControl
  x:Class="Axiom.Views.ProcessControlPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="35"
  d:DesignWidth="433"
  mc:Ignorable="d">

  <Grid Width="433" Height="35">

    <!--  Delete Preset ini  -->
    <Button
      x:Name="btnDeletePreset"
      Width="28"
      Height="28"
      Padding="0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Click="btnDeletePreset_Click"
      Cursor="Hand"
      ToolTip="Delete Preset"
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True">
      <iconPacks:PackIconPhosphorIcons
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Kind="TrashBold" />
    </Button>

    <!--  Save Preset ini  -->
    <Button
      x:Name="btnSavePreset"
      Width="28"
      Height="28"
      Margin="28,0"
      Padding="0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Click="btnSavePreset_Click"
      Cursor="Hand"
      ToolTip="Save Preset"
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True">
      <iconPacks:PackIconPhosphorIcons
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Kind="FloppyDiskBold" />
    </Button>

    <!--  Preset  -->
    <ComboBox
      x:Name="cboPreset"
      Width="75"
      Height="22"
      Margin="56,0,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      ItemsSource="{Binding MainView.Preset_Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      SelectedIndex="{Binding MainView.Preset_SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      SelectedValue="{Binding MainView.Preset_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      SelectedValuePath="Name"
      SelectionChanged="cboPreset_SelectionChanged">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid Width="93">
            <TextBlock DataContext="{Binding}">
              <TextBlock.Text>
                <Binding Path="Name" />
              </TextBlock.Text>
            </TextBlock>
          </Grid>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!--  Preview Button  -->
    <Button
      x:Name="btnPreview"
      Margin="0,0,87,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Click="btnPreview_Click"
      Cursor="Hand">
      <TextBlock x:Name="btnPreviewTextBlock" Text="Preview" />
    </Button>

    <!--  Convert Button  -->
    <Button
      x:Name="btnConvert"
      Width="75"
      Margin="0,0,4,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Click="btnConvert_Click"
      Cursor="Hand">
      <TextBlock x:Name="btnConvertTextBlock" Text="{Binding MainView.Convert_Text, Mode=TwoWay}" />
    </Button>

    <!--  Batch Checkbox  -->
    <ToggleButton
      x:Name="tglBatch"
      Margin="0,0,242,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Checked="tglBatch_Checked"
      Cursor="Hand"
      IsChecked="{Binding MainView.Batch_IsChecked, Mode=TwoWay}"
      ToolTip="Enable, Browse for folder, Enter file extention to batch process."
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True"
      Unchecked="tglBatch_Unchecked">
      <TextBlock
        x:Name="batchTextBlock"
        Style="{DynamicResource TextBlockStyle}"
        Text="Batch" />
    </ToggleButton>

    <!--  Batch Textbox  -->
    <TextBox
      x:Name="batchExtensionTextBox"
      Margin="0,0,177,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      IsEnabled="{Binding MainView.BatchExtension_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      Text="{Binding MainView.BatchExtension_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      TextChanged="batchExtension_TextChanged"
      TextWrapping="NoWrap"
      ToolTip="File Extension in Folder to Batch Process (e.g. mp4)"
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True" />

  </Grid>
</UserControl>
