<!--
  Process Control Panel
  Extracted from MainWindow.xaml (Lines 7845-8011)
  Contains: Preset Management and Convert/Preview buttons
-->
<UserControl
  x:Class="Axiom.Views.ProcessControlPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="35"
  d:DesignWidth="433"
  mc:Ignorable="d">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!--  Delete Preset Button  -->
    <Button
      x:Name="btnDeletePreset"
      Grid.Column="0"
      Width="28"
      Height="28"
      Margin="0,0,2,0"
      Padding="0"
      Click="btnDeletePreset_Click"
      Cursor="Hand"
      ToolTip="Delete Preset"
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True">
      <iconPacks:PackIconPhosphorIcons
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Kind="Trash" />
    </Button>

    <!--  Save Preset Button  -->
    <Button
      x:Name="btnSavePreset"
      Grid.Column="1"
      Width="28"
      Height="28"
      Margin="0,0,4,0"
      Padding="0"
      Click="btnSavePreset_Click"
      Cursor="Hand"
      ToolTip="Save Preset"
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True">
      <iconPacks:PackIconPhosphorIcons
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Kind="FloppyDisk" />
    </Button>

    <!--  Preset ComboBox  -->
    <ComboBox
      x:Name="cboPreset"
      Grid.Column="2"
      Width="75"
      Height="22"
      Margin="0,0,8,0"
      VerticalAlignment="Center"
      ItemsSource="{Binding MainView.Preset_Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      SelectedIndex="{Binding MainView.Preset_SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      SelectedValue="{Binding MainView.Preset_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      SelectedValuePath="Name"
      SelectionChanged="cboPreset_SelectionChanged">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <Grid Width="93">
            <TextBlock DataContext="{Binding}">
              <TextBlock.Text>
                <Binding Path="Name" />
              </TextBlock.Text>
            </TextBlock>
          </Grid>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!--  Spacer  -->
    <Grid Grid.Column="3" />

    <!--  Batch Toggle  -->
    <ToggleButton
      x:Name="tglBatch"
      Grid.Column="4"
      Margin="0,0,4,0"
      VerticalAlignment="Center"
      Checked="tglBatch_Checked"
      Cursor="Hand"
      IsChecked="{Binding MainView.Batch_IsChecked, Mode=TwoWay}"
      ToolTip="Enable, Browse for folder, Enter file extention to batch process."
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True"
      Unchecked="tglBatch_Unchecked">
      <TextBlock
        x:Name="batchTextBlock"
        Style="{DynamicResource TextBlockStyle}"
        Text="Batch" />
    </ToggleButton>

    <!--  Batch Extension TextBox  -->
    <TextBox
      x:Name="batchExtensionTextBox"
      Grid.Column="5"
      Margin="0,0,4,0"
      VerticalAlignment="Center"
      IsEnabled="{Binding MainView.BatchExtension_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      Text="{Binding MainView.BatchExtension_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      TextChanged="batchExtension_TextChanged"
      TextWrapping="NoWrap"
      ToolTip="File Extension in Folder to Batch Process (e.g. mp4)"
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True" />

    <!--  Preview Button  -->
    <Button
      x:Name="btnPreview"
      Grid.Column="6"
      Margin="0,0,4,0"
      VerticalAlignment="Center"
      Click="btnPreview_Click"
      Cursor="Hand">
      <TextBlock x:Name="btnPreviewTextBlock" Text="Preview" />
    </Button>

    <!--  Convert Button  -->
    <Button
      x:Name="btnConvert"
      Grid.Column="7"
      Width="75"
      Margin="0"
      VerticalAlignment="Center"
      Click="btnConvert_Click"
      Cursor="Hand">
      <TextBlock x:Name="btnConvertTextBlock" Text="{Binding MainView.Convert_Text, Mode=TwoWay}" />
    </Button>

  </Grid>
</UserControl>
