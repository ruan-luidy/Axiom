<UserControl
  x:Class="Axiom.Views.AudioSettingsControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:iconPack="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <Grid Background="Transparent">
    <ScrollViewer Width="254" HorizontalAlignment="Right">

      <Grid Margin="5,5,5,30" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  Encoding Group  -->
        <Grid
          Grid.Row="0"
          Margin="0,0,0,0"
          VerticalAlignment="Top">

          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="95" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="22" />
          </Grid.RowDefinitions>

          <Label
            Grid.Row="0"
            Grid.Column="1"
            Width="85"
            Height="26"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Audio Codec"
            FontFamily="Segoe UI Semilight" />
          <ComboBox
            x:Name="cboAudio_Codec"
            Grid.Column="2"
            Width="105"
            Height="22"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_Codec_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_Codec_Items}"
            SelectedIndex="{Binding Audio_Codec_SelectedIndex}"
            SelectedItem="{Binding Audio_Codec_SelectedItem}"
            SelectionChanged="cboAudio_Codec_SelectionChanged" />

          <!--  Stream Track  -->
          <Label
            Grid.Row="1"
            Grid.Column="1"
            Width="65"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Stream"
            FontFamily="Segoe UI Semilight"
            ToolTip="Audio Stream to keep."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />

          <ComboBox
            x:Name="cboAudio_Stream"
            Grid.Row="1"
            Grid.Column="2"
            Width="105"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_Stream_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_Stream_Items}"
            SelectedIndex="{Binding Audio_Stream_SelectedIndex}"
            SelectedItem="{Binding Audio_Stream_SelectedItem}"
            SelectionChanged="cboAudio_Stream_SelectionChanged"
            ToolTip="Audio Stream to keep."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />

          <!--  Channel  -->
          <Label
            Grid.Row="2"
            Grid.Column="1"
            Width="75"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Channel" />
          <ComboBox
            x:Name="cboAudio_Channel"
            Grid.Row="2"
            Grid.Column="2"
            Width="105"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_Channel_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_Channel_Items}"
            SelectedIndex="{Binding Audio_Channel_SelectedIndex}"
            SelectedItem="{Binding Audio_Channel_SelectedItem}"
            SelectionChanged="cboAudio_Channel_SelectionChanged" />

        </Grid>

        <!--  Quality Group  -->
        <Grid
          Grid.Row="1"
          Margin="0,0,0,0"
          VerticalAlignment="Top">

          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="95" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="22" />
          </Grid.RowDefinitions>

          <!--  Audio Quality  -->
          <Label
            Grid.Row="0"
            Grid.Column="1"
            Width="76"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Quality"
            FontFamily="Segoe UI Semilight" />
          <ComboBox
            x:Name="cboAudio_Quality"
            Grid.Row="0"
            Grid.Column="2"
            Width="105"
            Height="22"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_Quality_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_Quality_Items}"
            SelectedValue="{Binding Audio_Quality_SelectedItem, Mode=TwoWay}"
            SelectedValuePath="Name"
            SelectionChanged="cboAudio_Quality_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock DataContext="{Binding}">
                    <TextBlock.Text>
                      <Binding Path="Name" />
                    </TextBlock.Text>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!--  Bit Rate  -->
          <Label
            Grid.Row="1"
            Grid.Column="1"
            Width="85"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Bit Rate"
            FontFamily="Segoe UI Semilight" />

          <TextBox
            x:Name="tbxAudio_BitRate"
            Grid.Row="1"
            Grid.Column="2"
            Width="70"
            Height="22"
            Margin="0,2,0,0"
            Padding="2,1,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            GotFocus="tbxAudio_BitRate_GotFocus"
            IsEnabled="{Binding Audio_BitRate_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="tbxAudio_BitRate_KeyDown"
            LostFocus="tbxAudio_BitRate_LostFocus"
            MaxLength="5"
            MaxLines="1"
            Text="{Binding Audio_BitRate_Text, Mode=TwoWay}"
            TextChanged="tbxAudio_BitRate_TextChanged"
            TextWrapping="NoWrap"
            ToolTip="Custom Audio Bit Rate (e.g. 245)"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />

          <!--  VBR Toggle  -->
          <ToggleButton
            x:Name="tglAudio_VBR"
            Grid.Row="1"
            Grid.Column="2"
            Margin="75,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Checked="tglAudio_VBR_Checked"
            Content="VBR"
            Cursor="Hand"
            IsChecked="{Binding Audio_VBR_IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding Audio_VBR_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Toggle Variable Bit Rate for Vorbis (always), Opus, Lame, AAC, (if not Auto)."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True"
            Unchecked="tglAudio_VBR_Unchecked" />

          <!--  Compression Level  -->
          <Label
            Grid.Row="2"
            Grid.Column="1"
            Width="85"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Compression"
            ToolTip="Compression Level. Higher value is more compression."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />
          <ComboBox
            x:Name="cboAudio_CompressionLevel"
            Grid.Row="2"
            Grid.Column="2"
            Width="105"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_CompressionLevel_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_CompressionLevel_Items}"
            SelectedIndex="{Binding Audio_CompressionLevel_SelectedIndex}"
            SelectedItem="{Binding Audio_CompressionLevel_SelectedItem}"
            ToolTip="Compression Level. Higher value is more compression."
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />

          <!--  Sample Rate  -->
          <Label
            Grid.Row="3"
            Grid.Column="1"
            Width="85"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Sample Rate"
            FontFamily="Segoe UI Semilight" />
          <ComboBox
            x:Name="cboAudio_SampleRate"
            Grid.Row="3"
            Grid.Column="2"
            Width="105"
            Height="22"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_SampleRate_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_SampleRate_Items}"
            SelectedIndex="{Binding Audio_SampleRate_SelectedIndex}"
            SelectedValue="{Binding Audio_SampleRate_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedValuePath="Name"
            SelectionChanged="cboAudio_SampleRate_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock DataContext="{Binding}">
                    <TextBlock.Text>
                      <Binding Path="Name" />
                    </TextBlock.Text>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!--  Bit Depth  -->
          <Label
            x:Name="labelBitdepth"
            Grid.Row="4"
            Grid.Column="1"
            Width="85"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Bit Depth"
            FontFamily="Segoe UI Semilight" />
          <ComboBox
            x:Name="cboAudio_BitDepth"
            Grid.Row="4"
            Grid.Column="2"
            Width="105"
            Height="22"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_BitDepth_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_BitDepth_Items}"
            SelectedIndex="{Binding Audio_BitDepth_SelectedIndex}"
            SelectedValue="{Binding Audio_BitDepth_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedValuePath="Name"
            SelectionChanged="cboAudio_BitDepth_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock DataContext="{Binding}">
                    <TextBlock.Text>
                      <Binding Path="Name" />
                    </TextBlock.Text>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

        </Grid>


        <!--  Volume Group  -->
        <Grid
          Grid.Row="2"
          Margin="0,0,0,0"
          VerticalAlignment="Top">

          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="95" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="22" />
          </Grid.RowDefinitions>

          <!--  Volume  -->
          <Label
            Grid.Row="0"
            Grid.Column="1"
            Width="75"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Volume"
            FontFamily="Segoe UI Semilight" />
          <TextBox
            x:Name="tbxAudio_Volume"
            Grid.Row="0"
            Grid.Column="2"
            Width="105"
            Height="22"
            Margin="0,2,0,0"
            Padding="0,2,17,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_Volume_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="tbxAudio_Volume_KeyDown"
            MaxLength="6"
            MaxLines="1"
            Text="{Binding Audio_Volume_Text, Mode=TwoWay}"
            TextAlignment="Right"
            TextChanged="tbxAudio_Volume_TextChanged"
            TextWrapping="NoWrap" />

          <!--  Volume Up  -->
          <Button
            x:Name="btnAudio_VolumeUp"
            Grid.Row="0"
            Grid.Column="2"
            Width="14"
            Height="10"
            Margin="88,3,0,0"
            Padding="0,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="Transparent"
            Click="btnAudio_VolumeUp_Click"
            IsEnabled="{Binding Audio_Volume_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PreviewMouseLeftButtonDown="btnAudio_VolumeUp_PreviewMouseLeftButtonDown"
            PreviewMouseUp="btnAudio_VolumeUp_PreviewMouseUp"
            Style="{DynamicResource ButtonVolume}">
            <Image
              x:Name="glyphAudio_VolumeUp"
              Width="6"
              Height="5"
              Margin="1,1,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Style="{DynamicResource ButtonVolumeUp}" />
          </Button>

          <!--  Volume Down  -->
          <Button
            x:Name="btnAudio_VolumeDown"
            Grid.Row="0"
            Grid.Column="2"
            Width="14"
            Height="10"
            Margin="88,13,0,0"
            Padding="0,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="Transparent"
            Click="btnAudio_VolumeDown_Click"
            IsEnabled="{Binding Audio_Volume_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PreviewMouseLeftButtonDown="btnAudio_VolumeDown_PreviewMouseLeftButtonDown"
            PreviewMouseUp="btnAudio_VolumeDown_PreviewMouseUp"
            Style="{DynamicResource ButtonVolume}">
            <Image
              x:Name="glyphAudio_VolumeDown"
              Width="6"
              Height="5"
              Margin="1,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Style="{DynamicResource ButtonVolumeDown}" />
          </Button>

          <!--  Audio Limiter Toggle  -->
          <Label
            Grid.Row="1"
            Grid.Column="1"
            Width="85"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Hard Limiter"
            FontFamily="Segoe UI Semilight"
            ToolTip="Prevents audio from rising over a desired threshold." />
          <Slider
            x:Name="slAudio_HardLimiter"
            Grid.Row="1"
            Grid.Column="2"
            Width="61"
            Height="18"
            Margin="0,4,65,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_HardLimiter_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsMoveToPointEnabled="True"
            Maximum="0"
            Minimum="-24"
            MouseDoubleClick="slAudio_HardLimiter_MouseDoubleClick"
            PreviewMouseUp="slAudio_HardLimiter_PreviewMouseUp"
            Value="{Binding Audio_HardLimiter_Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox
            x:Name="tbxAudio_HardLimiter"
            Grid.Row="1"
            Grid.Column="2"
            Width="45"
            Margin="0,2,21,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Center"
            IsEnabled="{Binding Audio_HardLimiter_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            MaxLength="5"
            MaxLines="1"
            PreviewKeyUp="tbxAudio_HardLimiter_PreviewKeyUp"
            Text="{Binding Value, ElementName=slAudio_HardLimiter, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="NoWrap"
            ToolTip="dB"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />
        </Grid>

        <!--  Mux Group  -->
        <Grid
          Grid.Row="3"
          Margin="0,0,0,0"
          VerticalAlignment="Top">

          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="95" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <Grid.RowDefinitions>
            <RowDefinition Height="33" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="11" />
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="33" />
            <RowDefinition Height="22" />
          </Grid.RowDefinitions>

          <!--  Mux  -->
          <Label
            Grid.Row="0"
            Grid.Column="1"
            Width="95"
            Height="26"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Mux"
            FontFamily="Segoe UI Semibold" />

          <!--  Audio List  -->
          <ListView
            x:Name="lstvAudio"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Height="130"
            Margin="5,7,48,0"
            VerticalAlignment="Top"
            BorderThickness="0"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Audio_ListView_Items}"
            Opacity="{Binding Audio_ListView_Opacity}"
            SelectedIndex="{Binding Audio_ListView_SelectedIndex}"
            SelectionChanged="lstvAudio_SelectionChanged"
            SelectionMode="Single"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True">

            <ListView.Resources>
              <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="Visibility" Value="Collapsed" />
              </Style>
            </ListView.Resources>

            <ListView.ToolTip>
              <TextBlock>
                To enable, select Stream: mux.<LineBreak />
                <LineBreak />
                Add External Audio files. Mark CheckBox for Default.<LineBreak />
                <LineBreak />
                Select Codec: Copy to keep original file without converting.</TextBlock>
            </ListView.ToolTip>

            <!--  List Checkboxes  -->
            <ListView.View>
              <GridView>
                <!--  CheckBox  -->
                <GridViewColumn>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <!--  Name  -->
                <GridViewColumn Width="125" />
              </GridView>
            </ListView.View>
          </ListView>

          <!--  Add  -->
          <Button
            x:Name="btnAudio_Add"
            Grid.Row="1"
            Grid.Column="2"
            Width="22"
            Height="22"
            Margin="83,7,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnAudio_Add_Click"
            Cursor="Hand"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Add"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock Margin="0,-2,0,0" Text="+" />
          </Button>
          <!--  Remove  -->
          <Button
            x:Name="btnAudio_Remove"
            Grid.Row="1"
            Grid.Column="2"
            Width="22"
            Height="22"
            Margin="83,34,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnAudio_Remove_Click"
            Cursor="Hand"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Remove"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock Margin="0,-2,0,0" Text="-" />
          </Button>
          <!--  Sort Up  -->
          <Button
            x:Name="btnAudio_SortUp"
            Grid.Row="1"
            Grid.Column="2"
            Width="22"
            Height="22"
            Margin="83,88,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnAudio_SortUp_Click"
            Cursor="Hand"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBlock Margin="0,-2,0,0" Text="▴" />
          </Button>
          <!--  Sort Down  -->
          <Button
            x:Name="btnAudio_SortDown"
            Grid.Row="1"
            Grid.Column="2"
            Width="22"
            Height="22"
            Margin="83,115,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnAudio_SortDown_Click"
            Cursor="Hand"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBlock Margin="0,0,0,0" Text="▾" />
          </Button>
          <!--  Clear All  -->
          <Button
            x:Name="btnAudio_Clear"
            Grid.Row="1"
            Grid.Column="2"
            Width="22"
            Height="22"
            Margin="83,61,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="btnAudio_Clear_Click"
            Cursor="Hand"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Clear All"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock Margin="0,-3,0,0" Text="x" />
          </Button>

          <!--  Title Metadata  -->
          <Label
            Grid.Row="3"
            Grid.Column="1"
            Width="85"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Title"
            FontFamily="Segoe UI Semilight" />
          <TextBox
            x:Name="tbxAudio_Metadata_Title"
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Width="196"
            Height="22"
            Margin="5,2,0,0"
            Padding="2,1,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyUp="tbxAudio_Metadata_Title_KeyUp"
            LostFocus="tbxAudio_Metadata_Title_LostFocus"
            MaxLines="1"
            Text="{Binding Audio_Metadata_Title_Text, Mode=TwoWay}"
            TextWrapping="NoWrap"
            ToolTip="Stream Title Metadata"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />

          <!--  Language Metadata  -->
          <Label
            Grid.Row="5"
            Grid.Column="1"
            Width="85"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Language"
            FontFamily="Segoe UI Semilight"
            ToolTip="Stream Language Metadata"
            ToolTipService.InitialShowDelay="500"
            ToolTipService.ShowOnDisabled="True" />
          <ComboBox
            x:Name="cboAudio_Metadata_Language"
            Grid.Row="5"
            Grid.Column="2"
            Width="105"
            Height="22"
            Margin="0,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Audio_Metadata_Language_Items}"
            SelectedIndex="{Binding Audio_Metadata_Language_SelectedIndex}"
            SelectedValue="{Binding Audio_Metadata_Language_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectedValuePath="Name"
            SelectionChanged="cboAudio_Metadata_Language_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock DataContext="{Binding}">
                    <TextBlock.Text>
                      <Binding Path="Name" />
                    </TextBlock.Text>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!--  Delay  -->
          <!--<Label
                                 Content="Delay"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Width="85"
                                 FontFamily="Segoe UI Semilight"
                                 Grid.Row="6"
                                 Grid.Column="1" />-->
          <!--<TextBox x:Name="tbxAudio_Delay"
                                   Text="{Binding Audio_Delay_Text, Mode=TwoWay}"
                                   IsEnabled="{Binding Audio_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                   HorizontalAlignment="Left"
                                   Height="22"
                                   Width="105"
                                   Padding="2,1,0,0"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Top"
                                   MaxLines="1"
                                   ToolTipService.InitialShowDelay="500"
                                   ToolTipService.ShowOnDisabled="True"
                                   ToolTip="Positive or Negative Audio Delay (in milliseconds)"
                                   Grid.Column="2"
                                   Grid.Row="6"
                                   Margin="0,2,0,0"
                                   KeyUp="tbxAudio_Delay_KeyUp"
                                   />-->
        </Grid>

      </Grid>

    </ScrollViewer>
  </Grid>
</UserControl>
