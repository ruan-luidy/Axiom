<hc:Window
  x:Class="Axiom.DebugConsole"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Axiom.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Debug Console"
  Width="520"
  Height="560"
  Background="{DynamicResource Workspace.BackgroundBrush}"
  NonClientAreaBackground="{DynamicResource RegionBrush}"
  UseLayoutRounding="True"
  Icon="pack://application:,,,/Axiom;component/Resources/Images/Icons/DebugConsole.ico"
  mc:Ignorable="d">

  <hc:Window.NonClientAreaContent>
    <StackPanel
      Margin="0,0,8,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Center"
      Orientation="Horizontal"
      WindowChrome.IsHitTestVisibleInChrome="True">
      <Button
        x:Name="btnDebugMethods"
        Click="btnDebugMethods_Click"
        Content="Methods"
        Style="{StaticResource ButtonDefault.Small}" />
      <Button
        x:Name="btnDebugRandom"
        Margin="4,0,0,0"
        Click="btnDebugRandom_Click"
        Content="Random"
        Style="{StaticResource ButtonDefault.Small}" />
      <Button
        x:Name="btnDebugTest"
        Margin="4,0,0,0"
        Click="btnDebugTest_Click"
        Content="Test"
        Style="{StaticResource ButtonDefault.Small}" />
      <Button
        x:Name="btnExpand"
        Margin="4,0,0,0"
        Click="btnExpand_Click"
        Style="{StaticResource IconButton}"
        ToolTip="Expand Window">
        <Path Data="{icons:Phosphor ArrowsOutBold}" Style="{StaticResource Icon.Small}" />
      </Button>
    </StackPanel>
  </hc:Window.NonClientAreaContent>

  <Border Margin="8" Style="{StaticResource Card}">
    <RichTextBox
      x:Name="rtbDebug"
      IsReadOnly="True"
      IsUndoEnabled="False"
      Style="{StaticResource ConsoleText}" />
  </Border>
</hc:Window>
