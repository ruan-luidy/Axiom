<hc:Window
  x:Class="Axiom.UpdateWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Axiom.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Update"
  Width="420"
  Height="180"
  Background="{DynamicResource Workspace.BackgroundBrush}"
  NonClientAreaBackground="{DynamicResource RegionBrush}"
  UseLayoutRounding="True"
  Icon="pack://application:,,,/Axiom;component/axiom.ico"
  ResizeMode="NoResize"
  mc:Ignorable="d">

  <Border
    Margin="12"
    Padding="16"
    VerticalAlignment="Center"
    Style="{StaticResource Card}">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Path
          Data="{icons:Phosphor DownloadSimpleBold}"
          Fill="{DynamicResource PrimaryBrush}"
          Style="{StaticResource Icon.Small}" />
        <Label
          x:Name="labelProgressInfo"
          Margin="8,0,0,0"
          Padding="0"
          VerticalAlignment="Center"
          Background="Transparent"
          BorderThickness="0"
          Content=""
          FontSize="{StaticResource FontSize.Sm}"
          Foreground="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
      <ProgressBar
        x:Name="progressBar"
        Height="6"
        Margin="0,12,0,0"
        Style="{StaticResource ProgressBarFlat}"
        ToolTip="Download Progress" />
    </StackPanel>
  </Border>
</hc:Window>
