<hc:Window
  x:Class="Axiom.FailedImportWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Axiom.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Failed to Import"
  Width="420"
  Height="340"
  Background="{DynamicResource Workspace.BackgroundBrush}"
  NonClientAreaBackground="{DynamicResource RegionBrush}"
  UseLayoutRounding="True"
  Icon="pack://application:,,,/Axiom;component/axiom.ico"
  Loaded="Window_Loaded"
  ResizeMode="CanMinimize"
  mc:Ignorable="d">

  <Border Margin="8" Style="{StaticResource Card}">
    <RichTextBox
      x:Name="rtbFailedImport"
      IsReadOnly="True"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      Style="{StaticResource ConsoleText}" />
  </Border>
</hc:Window>
