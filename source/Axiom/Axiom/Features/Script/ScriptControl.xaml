<!--
  The FFmpeg script: generated from the options, editable, and runnable as it stands.
-->
<UserControl
  x:Class="Axiom.Features.Script.ScriptControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Axiom.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="520"
  mc:Ignorable="d">

  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--  Header: title, file and edit actions, then generate and run  -->
      <Border
        Padding="12,6,8,6"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Path
              Data="{icons:Phosphor TerminalBold}"
              Fill="{DynamicResource ThirdlyTextBrush}"
              Style="{StaticResource Icon.Small}" />
            <TextBlock
              Margin="8,0,0,0"
              Style="{StaticResource SectionHeaderStyle}"
              Text="SCRIPT" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button
              x:Name="btnScriptLoad"
              Click="btnScriptLoad_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Load a script from a file">
              <Path Data="{icons:Phosphor FolderOpenBold}" Style="{StaticResource Icon}" />
            </Button>
            <Button
              x:Name="btnScriptSave"
              Click="btnScriptSave_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Save the script to a file">
              <Path Data="{icons:Phosphor FloppyDiskBold}" Style="{StaticResource Icon}" />
            </Button>
            <Button
              x:Name="btnScriptCopy"
              Click="btnScriptCopy_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Copy">
              <Path Data="{icons:Phosphor CopyBold}" Style="{StaticResource Icon}" />
            </Button>
            <Button
              x:Name="btnScriptClear"
              Click="btnScriptClear_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Clear">
              <Path Data="{icons:Phosphor EraserBold}" Style="{StaticResource Icon}" />
            </Button>
            <Button
              x:Name="btnScriptSort"
              Margin="4,0,0,0"
              Padding="10,0"
              Click="btnScriptSort_Click"
              Style="{StaticResource ButtonDefault.Small}"
              ToolTip="Sort the arguments one per line, or put them back on one line">
              <TextBlock x:Name="txblScriptSort" Text="{Binding MainView.Sort_Text, Mode=TwoWay}" />
            </Button>
            <Button
              x:Name="btnScript"
              Margin="4,0,0,0"
              Click="btnScript_Click"
              Style="{StaticResource ButtonDefault.Small}"
              ToolTip="Generate FFmpeg Commands">
              <StackPanel Orientation="Horizontal">
                <Path Data="{icons:Phosphor MagicWandBold}" Style="{StaticResource Icon.Small}" />
                <TextBlock Margin="6,0,0,0" Text="Script" />
              </StackPanel>
            </Button>
            <Button
              x:Name="btnScriptRun"
              Margin="4,0,0,0"
              Click="btnScriptRun_Click"
              Style="{StaticResource ButtonDefault.Small}"
              ToolTip="Run the customized Script.">
              <StackPanel Orientation="Horizontal">
                <Path Data="{icons:Phosphor PlayBold}" Style="{StaticResource Icon.Small}" />
                <TextBlock Margin="6,0,0,0" Text="Run" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBox
        x:Name="tbxScriptView"
        Grid.Row="1"
        Height="Auto"
        MinHeight="0"
        Padding="12,10"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Top"
        hc:InfoElement.Placeholder="Press Script to generate the FFmpeg command"
        AcceptsReturn="True"
        AllowDrop="True"
        Background="Transparent"
        BorderThickness="0"
        FontFamily="{StaticResource Font.Mono}"
        FontSize="{StaticResource FontSize.Body}"
        PreviewDragOver="tbxScriptView_PreviewDragOver"
        PreviewDrop="tbxScriptView_PreviewDrop"
        RenderOptions.ClearTypeHint="Enabled"
        Style="{StaticResource TextBoxExtend}"
        Text="{Binding MainView.ScriptView_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto" />
    </Grid>
  </Border>
</UserControl>
