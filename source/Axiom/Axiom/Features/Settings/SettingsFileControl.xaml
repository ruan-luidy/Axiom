<!--
  Settings > File: what is stripped from input names and how output files are named.
-->
<UserControl
  x:Class="Axiom.Features.Settings.SettingsFileControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Axiom.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Axiom.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignWidth="700"
  mc:Ignorable="d">

  <controls:MasonryPanel Style="{StaticResource OptionPages}">

    <controls:OptionPanel Header="INPUT NAME" Icon="{icons:Phosphor FileBold}">
      <StackPanel>
        <controls:OptionRow Label="Tokens">
          <DockPanel>
            <Button
              DockPanel.Dock="Right"
              x:Name="btnInputFileNameTokensDefault"
              Click="btnInputFileNameTokensDefault_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Revert to Default">
              <Path Data="{icons:Phosphor ArrowCounterClockwiseBold}" Style="{StaticResource Icon.Small}" />
            </Button>
            <ComboBox
              x:Name="cboInputFileNameTokens"
              IsEnabled="{Binding InputFileNameTokens_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsTextSearchEnabled="False"
              ItemsSource="{Binding InputFileNameTokens_Items}"
              SelectedIndex="{Binding InputFileNameTokens_SelectedIndex}"
              SelectedItem="{Binding InputFileNameTokens_SelectedItem}"
              SelectionChanged="cboInputFileNameTokens_SelectionChanged" />
          </DockPanel>
        </controls:OptionRow>
        <controls:OptionRow Label="Custom" ToolTip="Add additional custom Input Filename Tokens to be removed, separated by commas.">
          <TextBox
            x:Name="tbxInputFileNameTokensCustom"
            IsEnabled="{Binding InputFileNameTokensCustom_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            MaxLines="1"
            Text="{Binding InputFileNameTokensCustom_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VerticalScrollBarVisibility="Auto"
            hc:InfoElement.Placeholder="token, token, ..." />
        </controls:OptionRow>
      </StackPanel>
    </controls:OptionPanel>

    <controls:OptionPanel Header="OUTPUT FILE" Icon="{icons:Phosphor FileArrowDownBold}">
      <StackPanel>
        <controls:OptionRow Label="Overwrite">
          <DockPanel>
            <Button
              DockPanel.Dock="Right"
              x:Name="btnOutputOverwriteDefault"
              Click="btnOutputOverwriteDefault_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Revert to Default">
              <Path Data="{icons:Phosphor ArrowCounterClockwiseBold}" Style="{StaticResource Icon.Small}" />
            </Button>
            <ComboBox
              x:Name="cboOutputOverwrite"
              IsEnabled="{Binding OutputOverwrite_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsTextSearchEnabled="False"
              ItemsSource="{Binding OutputOverwrite_Items}"
              SelectedIndex="{Binding OutputOverwrite_SelectedIndex}"
              SelectedItem="{Binding OutputOverwrite_SelectedItem}" />
          </DockPanel>
        </controls:OptionRow>
        <controls:OptionRow Label="Spacing">
          <DockPanel>
            <Button
              DockPanel.Dock="Right"
              x:Name="btnOutputFileNameSpacingDefault"
              Click="btnOutputFileNameSpacingDefault_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Revert to Default">
              <Path Data="{icons:Phosphor ArrowCounterClockwiseBold}" Style="{StaticResource Icon.Small}" />
            </Button>
            <ComboBox
              x:Name="cboOutputFileNameSpacing"
              IsEnabled="{Binding OutputFileNameSpacing_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsTextSearchEnabled="False"
              ItemsSource="{Binding OutputFileNameSpacing_Items}"
              SelectedIndex="{Binding OutputFileNameSpacing_SelectedIndex}"
              SelectedItem="{Binding OutputFileNameSpacing_SelectedItem}" />
          </DockPanel>
        </controls:OptionRow>
      </StackPanel>
    </controls:OptionPanel>

    <controls:OptionPanel Header="OUTPUT NAME TOKENS" Icon="{icons:Phosphor TextAaBold}">
      <StackPanel>
        <TextBlock
          Margin="0,0,0,6"
          Style="{StaticResource PanelNote}"
          Text="Checked settings are added to the output file name, in this order." />
        <DockPanel>
          <StackPanel Margin="6,0,0,0" DockPanel.Dock="Right">
            <Button
              x:Name="btnOutputNaming_SortUp"
              Click="btnOutputNaming_SortUp_Click"
              IsEnabled="{Binding OutputNaming_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Style="{StaticResource IconButton}"
              ToolTip="Move Up">
              <Path Data="{icons:Phosphor ArrowUpBold}" Style="{StaticResource Icon.Small}" />
            </Button>
            <Button
              x:Name="btnOutputNaming_SortDown"
              Click="btnOutputNaming_SortDown_Click"
              IsEnabled="{Binding OutputNaming_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Style="{StaticResource IconButton}"
              ToolTip="Move Down">
              <Path Data="{icons:Phosphor ArrowDownBold}" Style="{StaticResource Icon.Small}" />
            </Button>
            <Button
              x:Name="btnOutputNaming_SelectAll"
              Click="btnOutputNaming_SelectAll_Click"
              IsEnabled="{Binding OutputNaming_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Style="{StaticResource IconButton}"
              ToolTip="Select All">
              <Path Data="{icons:Phosphor ChecksBold}" Style="{StaticResource Icon.Small}" />
            </Button>
            <Button
              x:Name="btnOutputNaming_DeselectAll"
              Click="btnOutputNaming_DeselectAll_Click"
              IsEnabled="{Binding OutputNaming_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Style="{StaticResource IconButton}"
              ToolTip="Deselect All">
              <Path Data="{icons:Phosphor XBold}" Style="{StaticResource Icon.Small}" />
            </Button>
            <Button
              x:Name="btnOutputNamingDefaults"
              Click="btnOutputNamingDefaults_Click"
              Style="{StaticResource IconButton}"
              ToolTip="Load Default Positions and Selections">
              <Path Data="{icons:Phosphor ArrowCounterClockwiseBold}" Style="{StaticResource Icon.Small}" />
            </Button>
          </StackPanel>
          <ListView
            x:Name="lstvOutputNaming"
            Height="220"
            IsEnabled="{Binding OutputNaming_ListView_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsSynchronizedWithCurrentItem="False"
            ItemsSource="{Binding OutputNaming_ListView_Items}"
            SelectedIndex="{Binding OutputNaming_ListView_SelectedIndex}"
            SelectionChanged="lstvOutputNaming_SelectionChanged"
            SelectionMode="Multiple"
            Style="{StaticResource OptionList}">
            <ListView.Resources>
              <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="Visibility" Value="Collapsed" />
              </Style>
            </ListView.Resources>
            <ListView.View>
              <GridView>
                <!--  CheckBox  -->
                <GridViewColumn Width="Auto">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <!--  Name  -->
                <GridViewColumn Width="200" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </StackPanel>
    </controls:OptionPanel>

  </controls:MasonryPanel>
</UserControl>
