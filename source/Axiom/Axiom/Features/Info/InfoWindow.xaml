<hc:Window
  x:Name="windowInfo"
  x:Class="Axiom.InfoWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Axiom.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:ViewModel"
  Title="Info"
  Width="520"
  Height="440"
  Background="{DynamicResource Workspace.BackgroundBrush}"
  NonClientAreaBackground="{DynamicResource RegionBrush}"
  UseLayoutRounding="True"
  Icon="pack://application:,,,/Axiom;component/Resources/Images/Icons/info.ico"
  Loaded="Window_Loaded"
  mc:Ignorable="d">

  <hc:Window.DataContext>
    <local:VM />
  </hc:Window.DataContext>

  <Border Margin="8" Style="{StaticResource Card}">
    <TextBox
      Padding="14,12"
      VerticalContentAlignment="Top"
      Background="Transparent"
      BorderThickness="0"
      DataContext="{Binding MainView}"
      FontSize="{StaticResource FontSize.Body}"
      IsReadOnly="True"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      Style="{StaticResource TextBoxExtend}"
      Text="{Binding Info_Text}"
      TextAlignment="Left"
      TextWrapping="Wrap" />
  </Border>
</hc:Window>
