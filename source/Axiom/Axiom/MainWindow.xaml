          Margin="0,0,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Style="{DynamicResource ButtonCMD}" />
      </Button>

      <!--  Properties Button  -->
      <Button
        x:Name="btnProperties"
        Grid.Column="9"
        Width="22"
        Height="22"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="Transparent"
        Click="btnProperties_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonSmallStyle}"
        ToolTip="View File Properties"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="10"
          Height="11"
          Margin="0,0,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Style="{DynamicResource ButtonProperties}" />
      </Button>

      <!--  Play File  -->
      <Button
        x:Name="btnPlayFile"
        Grid.Column="10"
        Width="22"
        Height="22"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="Transparent"
        Click="btnPlayFile_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonSmallStyle}"
        ToolTip="Play Converted File"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="11"
          Height="11"
          Margin="-1,0,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Style="{DynamicResource ButtonPlay}" />
      </Button>

    </Grid>


    <!--  Process Buttons Grid  -->
    <Grid
      Width="433"
      Height="35"
      Margin="0,0,10,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom">

      <!--  Delete Preset ini  -->
      <Button
        x:Name="btnDeletePreset"
        Width="22"
        Height="22"
        Margin="0,0,0,13"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Background="Transparent"
        Click="btnDeletePreset_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonSmallStyle}"
        ToolTip="Delete Preset"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="9"
          Height="11"
          Margin="0,-1,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Fill"
          Style="{DynamicResource ButtonDeleteStyle}" />
      </Button>

      <!--  Save Preset ini  -->
      <Button
        x:Name="btnSavePreset"
        Width="22"
        Height="22"
        Margin="28,0,0,13"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Background="Transparent"
        Click="btnSavePreset_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonSmallStyle}"
        ToolTip="Save Preset"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="11"
          Height="11"
          Margin="0,-1,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Fill"
          Style="{DynamicResource ButtonExportStyle}" />
      </Button>

      <!--  Preset  -->
      <ComboBox
        x:Name="cboPreset"
        Width="75"
        Height="22"
        Margin="56,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        ItemContainerStyle="{DynamicResource ComboBoxCategoryStyleItem_FormatContainer}"
        ItemsSource="{Binding MainView.Preset_Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        SelectedIndex="{Binding MainView.Preset_SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        SelectedValue="{Binding MainView.Preset_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        SelectedValuePath="Name"
        SelectionChanged="cboPreset_SelectionChanged"
        Style="{DynamicResource ComboBoxCategoryStyle}">
        <ComboBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Margin="0,-7,0,0" />
          </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <Grid Width="93">
              <TextBlock DataContext="{Binding}">
                <TextBlock.Text>
                  <Binding Path="Name" />
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!--  Preview Button  -->
      <Button
        x:Name="btnPreview"
        Width="75"
        Height="22"
        Margin="0,0,87,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="btnPreview_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonStyle}">
        <TextBlock
          x:Name="btnPreviewTextBlock"
          Margin="0,-2,0,0"
          Text="Preview" />
      </Button>

      <!--  Convert Button  -->
      <Button
        x:Name="btnConvert"
        Width="75"
        Height="22"
        Margin="0,0,4,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="btnConvert_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonStyle}">
        <TextBlock
          x:Name="btnConvertTextBlock"
          Margin="0,-2,0,0"
          Text="{Binding MainView.Convert_Text, Mode=TwoWay}" />
      </Button>

      <!--  Batch Checkbox  -->
      <ToggleButton
        x:Name="tglBatch"
        Width="45"
        Height="22"
        Margin="0,0,242,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Checked="tglBatch_Checked"
        Cursor="Hand"
        IsChecked="{Binding MainView.Batch_IsChecked, Mode=TwoWay}"
        Style="{DynamicResource ToggleButtonStyle}"
        ToolTip="Enable, Browse for folder, Enter file extention to batch process."
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True"
        Unchecked="tglBatch_Unchecked">
        <TextBlock
          x:Name="batchTextBlock"
          Margin="0,-2,0,0"
          Style="{DynamicResource TextBlockStyle}"
          Text="Batch" />
      </ToggleButton>

      <!--  Batch Textbox  -->
      <TextBox
        x:Name="batchExtensionTextBox"
        Width="60"
        Height="23"
        Margin="0,0,177,0"
        Padding="2,1,0,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        IsEnabled="{Binding MainView.BatchExtension_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource TextBoxStyle}"
        Text="{Binding MainView.BatchExtension_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextChanged="batchExtension_TextChanged"
        TextWrapping="NoWrap"
        ToolTip="File Extension in Folder to Batch Process (e.g. mp4)"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True" />

    </Grid>

  </Grid>
</hc:Window>
