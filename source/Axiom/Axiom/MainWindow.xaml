<hc:Window
  x:Class="Axiom.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:System="clr-namespace:System;assembly=mscorlib"
  xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
  xmlns:Themes1="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:local="clr-namespace:ViewModel"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:my="clr-namespace:Axiom"
  xmlns:settings="clr-namespace:Axiom.Properties"
  Title="{Binding MainView.TitleVersion, Mode=OneWay}"
  Width="824"
  Height="464"
  Closing="Window_Closing"
  Icon="axiom.ico"
  Loaded="Window_Loaded"
  RenderOptions.BitmapScalingMode="Fant"
  Style="{DynamicResource WindowStyle}"
  UseLayoutRounding="True"
  mc:Ignorable="d">

  <hc:Window.DataContext>
    <local:VM />
  </hc:Window.DataContext>

  <Grid>

    <!--  Script View  -->
    <TextBox
      x:Name="tbxScriptView"
      Grid.ColumnSpan="1"
      Margin="11,71,280,56"
      Padding="10,10,10,48"
      AcceptsReturn="True"
      AllowDrop="True"
      FontSize="14"
      PreviewDragOver="tbxScriptView_PreviewDragOver"
      PreviewDrop="tbxScriptView_PreviewDrop"
      RenderOptions.ClearTypeHint="Enabled"
      Style="{DynamicResource TextBoxScriptView}"
      Text="{Binding MainView.ScriptView_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto" />

    <!--  Save Button  -->
    <Button
      x:Name="btnScriptSave"
      Width="59"
      Height="22"
      Margin="86,0,0,66"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Click="btnScriptSave_Click"
      Cursor="Hand"
      Style="{DynamicResource ButtonStyle}">
      <TextBlock Margin="0,-2,0,0" Text="Save" />
    </Button>

    <!--  Load Button  -->
    <Button
      x:Name="btnScriptLoad"
      Width="59"
      Height="22"
      Margin="20,0,0,66"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Click="btnScriptLoad_Click"
      Cursor="Hand"
      Style="{DynamicResource ButtonStyle}">
      <TextBlock Margin="0,-2,0,0" Text="Load" />
    </Button>

    <!--  Copy Button  -->
    <Button
      x:Name="btnScriptCopy"
      Width="59"
      Height="22"
      Margin="152,0,0,66"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Click="btnScriptCopy_Click"
      Cursor="Hand"
      Style="{DynamicResource ButtonStyle}">
      <TextBlock Margin="0,-2,0,0" Text="Copy" />
    </Button>

    <!--  Sort Button  -->
    <Button
      x:Name="btnScriptSort"
      Width="59"
      Height="22"
      Margin="284,0,0,66"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Click="btnScriptSort_Click"
      Cursor="Hand"
      Style="{DynamicResource ButtonStyle}">
      <TextBlock
        x:Name="txblScriptSort"
        Width="50"
        Margin="0,-2,0,0"
        Text="{Binding MainView.Sort_Text, Mode=TwoWay}"
        TextAlignment="Center" />
    </Button>

    <!--  Clear Button  -->
    <Button
      x:Name="btnScriptClear"
      Width="59"
      Height="22"
      Margin="218,0,0,66"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Click="btnScriptClear_Click"
      Cursor="Hand"
      Style="{DynamicResource ButtonStyle}">
      <TextBlock
        x:Name="txblScriptClear"
        Width="50"
        Margin="0,-2,0,0"
        Text="Clear"
        TextAlignment="Center" />
    </Button>

    <!--  Script Button  -->
    <Button
      x:Name="btnScript"
      Width="75"
      Height="22"
      Margin="350,0,0,66"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Click="btnScript_Click"
      Cursor="Hand"
      Style="{DynamicResource ButtonStyle}"
      ToolTip="Generate FFmpeg Commands"
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True">
      <TextBlock Margin="0,-2,0,0" Text="Script" />
    </Button>

    <!--  Run Button  -->
    <Button
      x:Name="btnScriptRun"
      Width="72"
      Height="22"
      Margin="432,0,0,66"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Click="btnScriptRun_Click"
      Cursor="Hand"
      Style="{DynamicResource ButtonStyle}"
      ToolTip="Run the customized Script."
      ToolTipService.InitialShowDelay="500"
      ToolTipService.ShowOnDisabled="True">
      <TextBlock Margin="0,-2,0,0" Text="Run" />
    </Button>


    <!--  Input / Output Grid  -->
    <Grid
      Height="56"
      Margin="10,10,280,0"
      VerticalAlignment="Top">

      <!--  Browse Button  -->
      <Button
        x:Name="btnInput"
        Width="70"
        Height="22"
        Margin="0,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Click="btnInput_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonStyle}">
        <TextBlock Margin="0,-2,0,0" Text="Input" />
      </Button>

      <!--  Browse Textbox  -->
      <TextBox
        x:Name="tbxInput"
        Height="22"
        Margin="75,0,0,0"
        Padding="2,1,50,0"
        VerticalAlignment="Top"
        AllowDrop="True"
        MaxLines="1"
        PreviewDragOver="tbxInput_PreviewDragOver"
        PreviewDrop="tbxInput_PreviewDrop"
        Style="{DynamicResource TextBoxBrowseStyle}"
        Text="{Binding MainView.Input_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextChanged="tbxInput_TextChanged"
        TextWrapping="NoWrap" />

      <!--  Input Clear Button  -->
      <Button
        x:Name="btnInputClear"
        Width="22"
        Height="20"
        Margin="0,1,24,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="btnInputClear_Click"
        Cursor="Hand"
        IsEnabled="{Binding MainView.Input_Clear_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource ButtonFolderStyle}"
        ToolTip="Clear"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="10"
          Height="7"
          Margin="0,0,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Style="{DynamicResource ButtonClear}" />
      </Button>

      <!--  Input Location Button  -->
      <Button
        x:Name="openLocationInput"
        Width="22"
        Height="20"
        Margin="0,1,1,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="openLocationInput_Click"
        Cursor="Hand"
        IsEnabled="{Binding MainView.Input_Location_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource ButtonFolderStyle}"
        ToolTip="Open this location"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="11"
          Height="7"
          Margin="1,0,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Style="{DynamicResource ButtonQuickFolder}" />
      </Button>

      <!--  Output Button  -->
      <Button
        x:Name="btnOutput"
        Width="70"
        Height="22"
        Margin="0,29,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Click="btnOutput_Click"
        Cursor="Hand"
        Style="{DynamicResource ButtonStyle}">
        <TextBlock Margin="0,-2,0,0" Text="Output" />
      </Button>
      <!--  Output Textbox  -->
      <TextBox
        x:Name="tbxOutput"
        Height="22"
        Margin="75,29,0,0"
        Padding="2,1,25,0"
        VerticalAlignment="Top"
        AllowDrop="True"
        MaxLines="1"
        PreviewDragOver="tbxOutput_PreviewDragOver"
        PreviewDrop="tbxOutput_PreviewDrop"
        PreviewKeyUp="tbxOutput_PreviewKeyUp"
        Style="{DynamicResource TextBoxBrowseStyle}"
        Text="{Binding MainView.Output_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextChanged="tbxOutput_TextChanged"
        TextWrapping="NoWrap" />

      <!--  Output Clear Button  -->
      <Button
        x:Name="btnOutputClear"
        Width="22"
        Height="20"
        Margin="0,30,24,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="btnOutputClear_Click"
        Cursor="Hand"
        IsEnabled="{Binding MainView.Output_Clear_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource ButtonFolderStyle}"
        ToolTip="Clear"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="10"
          Height="7"
          Margin="0,0,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Style="{DynamicResource ButtonClear}" />
      </Button>
      <!--  Output Location Button  -->
      <Button
        x:Name="openLocationOutput"
        Width="22"
        Height="20"
        Margin="0,30,1,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="openLocationOutput_Click"
        Cursor="Hand"
        IsEnabled="{Binding MainView.Output_Location_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource ButtonFolderStyle}"
        ToolTip="Open this location"
        ToolTipService.InitialShowDelay="500"
        ToolTipService.ShowOnDisabled="True">
        <Image
          Width="11"
          Height="7"
          Margin="1,0,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Stretch="Uniform"
          Style="{DynamicResource ButtonQuickFolder}" />
      </Button>

    </Grid>


    <!--  Tab Control  -->
    <TabControl
      x:Name="tabControl"
      Width="260"
      Margin="0,10,10,56"
      HorizontalAlignment="Right"
      Background="Transparent">

      <!--  Format Tab  -->
      <TabItem
        Width="85"
        DataContext="{Binding FormatView}"
        Header="Format"
        Style="{DynamicResource TabItemStyle}">

        <Grid Background="Transparent">

          <!--  Scroll Viewer  -->
          <ScrollViewer
            Width="254"
            HorizontalAlignment="Right"
            Template="{DynamicResource ScrollViewerControlTemplate}">

            <!--  Grid  -->
            <Grid Margin="0,20,0,30" VerticalAlignment="Top">

              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid.RowDefinitions>
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="22" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="22" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
              </Grid.RowDefinitions>

              <!--  Container  -->
              <Label
                Grid.Column="1"
                Width="86"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="Container"
                FontFamily="Segoe UI Semilight"
                Style="{DynamicResource LabelStyle}" />
              <ComboBox
                x:Name="cboFormat_Container"
                Grid.Column="2"
                Width="105"
                Height="22"
                Margin="0,2,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ItemContainerStyle="{DynamicResource ComboBoxCategoryStyleItem_FormatContainer}"
                ItemsSource="{Binding Format_Container_Items}"
                PreviewMouseUp="cboFormat_Container_PreviewMouseUp"
                SelectedValue="{Binding Format_Container_SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Name"
                SelectionChanged="cboFormat_Container_SelectionChanged"
                Style="{DynamicResource ComboBoxCategoryStyle}">
                <ComboBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Margin="0,-7,0,0" />
                  </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <TextBlock DataContext="{Binding}">
                        <TextBlock.Text>
                          <Binding Path="Name" />
                        </TextBlock.Text>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <!--  MediaType  -->
              <Label
                Grid.Row="1"
                Grid.Column="1"
                Width="86"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="Media"
                FontFamily="Segoe UI Semilight"
                Style="{DynamicResource LabelStyle}" />
              <ComboBox
                x:Name="cboFormat_MediaType"
                Grid.Row="1"
                Grid.Column="2"
                Width="105"
                Height="22"
                Margin="0,2,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsEnabled="{Binding Format_MediaType_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ItemContainerStyle="{DynamicResource ComboBoxStyleItem}"
                ItemsSource="{Binding Format_MediaType_Items}"
                SelectedItem="{Binding Format_MediaType_SelectedItem, Mode=TwoWay}"
                SelectionChanged="cboFormat_MediaType_SelectionChanged"
                Style="{DynamicResource ComboBoxStyle}" />

              <!--  Cut  -->
              <Label
                Grid.Row="3"
                Grid.Column="1"
                Width="86"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="Cut"
                FontFamily="Segoe UI Semilight"
                Style="{DynamicResource LabelStyle}" />
              <ComboBox
                x:Name="cboFormat_Cut"
                Grid.Row="3"
                Grid.Column="2"
                Width="105"
                Height="22"
                Margin="0,3,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsEnabled="{Binding Format_Cut_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ItemContainerStyle="{DynamicResource ComboBoxCategoryStyleItem}"
                ItemsSource="{Binding Format_Cut_Items}"
                SelectedIndex="{Binding Format_Cut_SelectedIndex}"
                SelectedItem="{Binding Format_Cut_SelectedItem, Mode=TwoWay}"
                SelectionChanged="cboFormat_Cut_SelectionChanged"
                Style="{DynamicResource ComboBoxCategoryStyle}" />

              <!--  Cut Start  -->
              <Label
                Grid.Row="4"
                Grid.Column="1"
                Width="86"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="Start Time"
                FontFamily="Segoe UI Semilight"
                Style="{DynamicResource LabelStyle}" />
              <!--  Hours  -->
              <TextBox
                x:Name="tbxCutStartHours"
                Grid.Row="4"
                Grid.Column="2"
                Width="21"
                Height="22"
                Margin="1,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutStartHours_GotFocus"
                IsEnabled="{Binding Format_CutStart_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tbxCutStartHours_KeyDown"
                LostFocus="tbxCutStartHours_LostFocus"
                MaxLength="2"
                MaxLines="1"
                Style="{DynamicResource TextBoxCut}"
                Text="{Binding Format_CutStart_Hours_Text, Mode=TwoWay}"
                TextWrapping="NoWrap"
                ToolTip="Hours"
                ToolTipService.InitialShowDelay="500"
                ToolTipService.ShowOnDisabled="True" />
              <Label
                x:Name="lblCutStartHours"
                Grid.Row="4"
                Grid.Column="2"
                Width="3"
                Height="18"
                Margin="21,4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Content=":"
                FontFamily="Segoe UI Semilight"
                IsEnabled="{Binding Format_CutStart_IsEnabled}"
                Style="{DynamicResource LabelCut}" />

              <!--  Minutes  -->
              <TextBox
                x:Name="tbxCutStartMinutes"
                Grid.Row="4"
                Grid.Column="2"
                Width="21"
                Height="22"
                Margin="22,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutStartMinutes_GotFocus"
                IsEnabled="{Binding Format_CutStart_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tbxCutStartMinutes_KeyDown"
                LostFocus="tbxCutStartMinutes_LostFocus"
                MaxLength="2"
                MaxLines="1"
                Style="{DynamicResource TextBoxCut}"
                Text="{Binding Format_CutStart_Minutes_Text, Mode=TwoWay}"
                TextWrapping="NoWrap"
                ToolTip="Minutes"
                ToolTipService.InitialShowDelay="500"
                ToolTipService.ShowOnDisabled="True" />
              <Label
                x:Name="lblCutStartMinutes"
                Grid.Row="4"
                Grid.Column="2"
                Width="3"
                Height="18"
                Margin="42,4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Content=":"
                FontFamily="Segoe UI Semilight"
                IsEnabled="{Binding Format_CutStart_IsEnabled}"
                Style="{DynamicResource LabelCut}" />

              <!--  Seconds  -->
              <TextBox
                x:Name="tbxCutStartSeconds"
                Grid.Row="4"
                Grid.Column="2"
                Width="21"
                Height="22"
                Margin="43,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutStartSeconds_GotFocus"
                IsEnabled="{Binding Format_CutStart_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tbxCutStartSeconds_KeyDown"
                LostFocus="tbxCutStartSeconds_LostFocus"
                MaxLength="2"
                MaxLines="1"
                Style="{DynamicResource TextBoxCut}"
                Text="{Binding Format_CutStart_Seconds_Text, Mode=TwoWay}"
                TextWrapping="NoWrap"
                ToolTip="Seconds"
                ToolTipService.InitialShowDelay="500"
                ToolTipService.ShowOnDisabled="True" />
              <Label
                x:Name="lblCutStartSeconds"
                Grid.Row="4"
                Grid.Column="2"
                Width="3"
                Margin="63,4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Content="."
                FontFamily="Segoe UI Semilight"
                IsEnabled="{Binding Format_CutStart_IsEnabled}"
                Style="{DynamicResource LabelCut}" />

              <!--  Milliseconds  -->
              <TextBox
                x:Name="tbxCutStartMilliseconds"
                Grid.Row="4"
                Grid.Column="2"
                Width="30"
                Height="22"
                Margin="64,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutStartMilliseconds_GotFocus"
                IsEnabled="{Binding Format_CutStart_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tbxCutStartMilliseconds_KeyDown"
                LostFocus="tbxCutStartMilliseconds_LostFocus"
                MaxLength="3"
                MaxLines="1"
                Style="{DynamicResource TextBoxCut}"
                Text="{Binding Format_CutStart_Milliseconds_Text, Mode=TwoWay}"
                TextWrapping="NoWrap"
                ToolTip="Milliseconds"
                ToolTipService.InitialShowDelay="500"
                ToolTipService.ShowOnDisabled="True" />
              <!--  Background  -->
              <TextBox
                x:Name="tbxCutStart"
                Grid.Row="4"
                Grid.Column="2"
                Width="105"
                Height="22"
                Margin="0,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Cursor="Arrow"
                IsEnabled="{Binding Format_CutStart_IsEnabled}"
                IsReadOnly="True"
                Style="{DynamicResource TextBoxStyle}"
                Text=""
                TextWrapping="NoWrap" />


              <!--  Cut End  -->
              <Label
                Grid.Row="5"
                Grid.Column="1"
                Width="86"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="End Time"
                FontFamily="Segoe UI Semilight"
                Style="{DynamicResource LabelStyle}" />

              <!--  Hours  -->
              <TextBox
                x:Name="tbxCutEndHours"
                Grid.Row="5"
                Grid.Column="2"
                Width="21"
                Height="22"
                Margin="1,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutEndHours_GotFocus"
                IsEnabled="{Binding Format_CutEnd_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tbxCutEndHours_KeyDown"
                LostFocus="tbxCutEndHours_LostFocus"
                MaxLength="2"
                MaxLines="1"
                Style="{DynamicResource TextBoxCut}"
                Text="{Binding Format_CutEnd_Hours_Text, Mode=TwoWay}"
                TextWrapping="NoWrap"
                ToolTip="Hours"
                ToolTipService.InitialShowDelay="500"
                ToolTipService.ShowOnDisabled="True" />
              <Label
                x:Name="lblCutEndHours"
                Grid.Row="5"
                Grid.Column="2"
                Width="3"
                Height="18"
                Margin="21,4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Content=":"
                FontFamily="Segoe UI Semilight"
                IsEnabled="{Binding Format_CutEnd_IsEnabled}"
                Style="{DynamicResource LabelCut}" />
              <!--  Minutes  -->
              <TextBox
                x:Name="tbxCutEndMinutes"
                Grid.Row="5"
                Grid.Column="2"
                Width="21"
                Height="22"
                Margin="22,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutEndMinutes_GotFocus"
                IsEnabled="{Binding Format_CutEnd_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tbxCutEndMinutes_KeyDown"
                LostFocus="tbxCutEndMinutes_LostFocus"
                MaxLength="2"
                MaxLines="1"
                Style="{DynamicResource TextBoxCut}"
                Text="{Binding Format_CutEnd_Minutes_Text, Mode=TwoWay}"
                TextWrapping="NoWrap"
                ToolTip="Minutes"
                ToolTipService.InitialShowDelay="500"
                ToolTipService.ShowOnDisabled="True" />
              <Label
                x:Name="lblCutEndMinutes"
                Grid.Row="5"
                Grid.Column="2"
                Width="3"
                Height="18"
                Margin="42,4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Content=":"
                FontFamily="Segoe UI Semilight"
                IsEnabled="{Binding Format_CutEnd_IsEnabled}"
                Style="{DynamicResource LabelCut}" />
              <!--  Seconds  -->
              <TextBox
                x:Name="tbxCutEndSeconds"
                Grid.Row="5"
                Grid.Column="2"
                Width="21"
                Height="22"
                Margin="43,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutEndSeconds_GotFocus"
                IsEnabled="{Binding Format_CutEnd_IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="tbxCutEndSeconds_KeyDown"
                LostFocus="tbxCutEndSeconds_LostFocus"
                MaxLength="2"
                MaxLines="1"
                Style="{DynamicResource TextBoxCut}"
                Text="{Binding Format_CutEnd_Seconds_Text, Mode=TwoWay}"
                TextWrapping="NoWrap"
                ToolTip="Seconds"
                ToolTipService.InitialShowDelay="500"
                ToolTipService.ShowOnDisabled="True" />
              <Label
                x:Name="lblCutEndSeconds"
                Grid.Row="5"
                Grid.Column="2"
                Width="3"
                Margin="63,4,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Content="."
                FontFamily="Segoe UI Semilight"
                IsEnabled="{Binding Format_CutEnd_IsEnabled}"
                Style="{DynamicResource LabelCut}" />
              <!--  Milliseconds  -->
              <TextBox
                x:Name="tbxCutEndMilliseconds"
                Grid.Row="5"
                Grid.Column="2"
                Width="30"
                Height="22"
                Margin="64,3,0,0"
                Padding="1,1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="2"
                GotFocus="tbxCutEndMilliseconds_GotFocus"
