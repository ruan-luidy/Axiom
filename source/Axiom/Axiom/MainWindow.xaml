<hc:Window
  x:Class="Axiom.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:System="clr-namespace:System;assembly=mscorlib"
  xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
  xmlns:Themes1="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
  xmlns:local="clr-namespace:ViewModel"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:my="clr-namespace:Axiom"
  xmlns:settings="clr-namespace:Axiom.Properties"
  xmlns:views="clr-namespace:Axiom.Views"
  Title="{Binding MainView.TitleVersion, Mode=OneWay}"
  Width="824"
  Height="464"
  Closing="Window_Closing"
  Icon="axiom.ico"
  Loaded="Window_Loaded"
  RenderOptions.BitmapScalingMode="HighQuality"
  Style="{DynamicResource WindowWin10}"
  UseLayoutRounding="True"
  mc:Ignorable="d">

  <hc:Window.DataContext>
    <local:VM />
  </hc:Window.DataContext>

  <Grid>

    <!--  Script View  -->
    <views:ScriptControl Margin="11,71,280,56" />

    <!--  Input / Output Grid  -->
    <views:InputOutputControl Margin="10,10,280,0" VerticalAlignment="Top" />

    <!--  Tab Control  -->
    <TabControl
      x:Name="tabControl"
      Width="260"
      Margin="0,10,10,56"
      HorizontalAlignment="Right"
      Background="Transparent"
      TabStripPlacement="Top">

      <!--  Format Tab  -->
      <TabItem
        HorizontalContentAlignment="Stretch"
        DataContext="{Binding FormatView}"
        Header="Format">
        <views:FormatControl />
      </TabItem>

      <!--  Video Tab  -->
      <TabItem HorizontalContentAlignment="Stretch" Header="Video">

        <Grid Background="Transparent">
          <ScrollViewer Width="254" HorizontalAlignment="Right" VerticalScrollBarVisibility="Auto">

            <!--  Video TabControl  -->
            <TabControl
              x:Name="tabVideo"
              Margin="0,0,0,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="Transparent"
              BorderThickness="0"
              TabStripPlacement="Top">

              <!--  Encoding Tab  -->
              <TabItem HorizontalContentAlignment="Stretch" Header="Encoding">
                <views:VideoEncodingControl />
              </TabItem>

              <!--  Color Tab  -->
              <TabItem
                HorizontalContentAlignment="Stretch"
                DataContext="{Binding VideoView}"
                Header="Color">
                <views:VideoColorControl />
              </TabItem>

              <!--  Size Tab  -->
              <TabItem HorizontalContentAlignment="Stretch" Header="Size">
                <views:VideoSizeControl />
              </TabItem>

            </TabControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!--  Audio Tab  -->
      <TabItem
        HorizontalContentAlignment="Stretch"
        DataContext="{Binding AudioView}"
        Header="Audio">
        <views:AudioSettingsControl />
      </TabItem>

      <!--  Subtitles Tab  -->
      <TabItem
        HorizontalContentAlignment="Stretch"
        DataContext="{Binding SubtitleView}"
        Header="Subtitles">
        <views:SubtitlesControl />
      </TabItem>

      <!--  Filters Tab  -->
      <TabItem HorizontalContentAlignment="Stretch" Header="Filters">

        <Grid Background="Transparent">
          <ScrollViewer Width="254" HorizontalAlignment="Right" VerticalScrollBarVisibility="Auto">

            <!--  Filters TabControl  -->
            <TabControl
              x:Name="tabFilters"
              Margin="0,0,0,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="Transparent"
              BorderThickness="0"
              TabStripPlacement="Top">

              <!--  Video Filter Tab  -->
              <TabItem
                HorizontalContentAlignment="Stretch"
                DataContext="{Binding FilterVideoView}"
                Header="Video">
                <views:FilterVideoControl />
              </TabItem>

              <!--  Audio Filter Tab  -->
              <TabItem
                HorizontalContentAlignment="Stretch"
                DataContext="{Binding FilterAudioView}"
                Header="Audio">
                <views:FilterAudioControl />
              </TabItem>

            </TabControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!--  Settings Tab  -->
      <TabItem HorizontalContentAlignment="Stretch" Header="Settings">

        <Grid Background="Transparent">
          <ScrollViewer Width="254" HorizontalAlignment="Right" VerticalScrollBarVisibility="Auto">

            <!--  Settings TabControl  -->
            <TabControl
              x:Name="tabSettings"
              Margin="0,0,0,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="Transparent"
              BorderThickness="0"
              TabStripPlacement="Top">

              <!--  Config Tab  -->
              <TabItem
                HorizontalContentAlignment="Stretch"
                DataContext="{Binding ConfigView}"
                Header="Config">
                <views:SettingsConfigControl />
              </TabItem>

              <!--  File Tab  -->
              <TabItem
                HorizontalContentAlignment="Stretch"
                DataContext="{Binding SettingsView}"
                Header="File">
                <views:SettingsFileControl />
              </TabItem>

              <!--  System Tab  -->
              <TabItem
                HorizontalContentAlignment="Stretch"
                DataContext="{Binding SystemView}"
                Header="System">
                <views:SettingsSystemControl />
              </TabItem>

            </TabControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

    </TabControl>

    <!--  Tool Buttons Grid  -->
    <views:ToolbarControl
      Margin="10,0,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom" />

    <!--  Process Buttons Grid  -->
    <views:ProcessControlPanel
      Margin="0,0,10,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom" />

  </Grid>
</hc:Window>
